const { WebSocketServer, WebSocket } = require("ws");

const wss = new WebSocketServer({
    port: process.env.PORT || 8080
});

const players = new Map(); // playerId -> { ws, state: {x,y,dir,nickname}, battleId: string|null }
const battles = new Map(); // battleId -> { battleId, p1, p2, turn }

function send(ws, message) {
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify(message));
    }
}

function broadcast(message, exceptWs = null) {
    const payload = JSON.stringify(message);

    for (const client of wss.clients) {
        if (client !== exceptWs && client.readyState === WebSocket.OPEN) {
            client.send(payload);
        }
    }
}

function sendToPlayer(playerId, message) {
    const entry = players.get(playerId);
    if (entry) send(entry.ws, message);
}

function makeBattleId() {
    return "b" + Math.random().toString(36).slice(2, 10);
}

wss.on("connection", (ws) => {
    ws.isAlive = true;
    ws.on("pong", () => { ws.isAlive = true; });

    ws.on("message", (raw) => {
        let data;

        try {
            data = JSON.parse(raw.toString());
        } catch (error) {
            console.error("Bad message:", error);
            return;
        }

        // ---------- JOIN ----------
        if (data.type === "join") {
            const playerId = String(data.playerId || "");

            if (!playerId) {
                ws.close(1008, "Missing player ID");
                return;
            }

            ws.playerId = playerId;

            const playerState = {
                playerId,
                nickname: data.nickname || "Trainer",
                x: Number(data.x) || 8,
                y: Number(data.y) || 18,
                dir: data.dir || "down"
            };

            players.set(playerId, { ws, state: playerState, battleId: null });

            send(ws, {
                type: "worldState",
                players: [...players.values()]
                    .filter(entry => entry.ws !== ws)
                    .map(entry => entry.state)
            });

            broadcast({ type: "playerJoined", player: playerState }, ws);

            console.log(`${playerId} joined the overworld`);
            return;
        }

        if (!ws.playerId || !players.has(ws.playerId)) return;

        const self = players.get(ws.playerId);

        // ---------- OVERWORLD MOVEMENT ----------
        if (data.type === "state") {
            self.state.x = Number(data.x) || self.state.x;
            self.state.y = Number(data.y) || self.state.y;
            self.state.dir = data.dir || self.state.dir;

            broadcast({
                type: "state",
                playerId: ws.playerId,
                x: self.state.x,
                y: self.state.y,
                dir: self.state.dir
            }, ws);

            return;
        }

        // ---------- BATTLE REQUEST / RESPONSE ----------
        if (data.type === "battleRequest") {
            const targetId = String(data.targetId || "");
            const target = players.get(targetId);

            if (!target || self.battleId || target.battleId) {
                send(ws, { type: "battleRequestFailed", targetId, reason: "unavailable" });
                return;
            }

            sendToPlayer(targetId, {
                type: "battleRequestReceived",
                fromId: ws.playerId,
                fromNickname: self.state.nickname
            });

            return;
        }

        if (data.type === "battleAccept") {
            const fromId = String(data.fromId || "");
            const challenger = players.get(fromId);

            if (!challenger || self.battleId || challenger.battleId) {
                sendToPlayer(fromId, { type: "battleDeclined", byId: ws.playerId, reason: "unavailable" });
                return;
            }

            const battleId = makeBattleId();
            const firstTurn = Math.random() < 0.5 ? fromId : ws.playerId;

            battles.set(battleId, {
                battleId,
                p1: fromId,
                p2: ws.playerId,
                turn: firstTurn
            });

            self.battleId = battleId;
            challenger.battleId = battleId;

            const startMsg = { type: "battleStart", battleId, p1: fromId, p2: ws.playerId, turn: firstTurn };

            sendToPlayer(fromId, startMsg);
            sendToPlayer(ws.playerId, startMsg);

            return;
        }

        if (data.type === "battleDecline") {
            const fromId = String(data.fromId || "");
            sendToPlayer(fromId, { type: "battleDeclined", byId: ws.playerId, reason: "declined" });
            return;
        }

        // ---------- BATTLE ACTIONS ----------
        if (data.type === "battleAction") {
            const battleId = data.battleId;
            const b = battles.get(battleId);

            if (!b) return;
            if (b.p1 !== ws.playerId && b.p2 !== ws.playerId) return;

            // Server enforces turn order so a client can't act twice in a row.
            if (b.turn !== ws.playerId) return;

            const opponentId = b.p1 === ws.playerId ? b.p2 : b.p1;
            b.turn = opponentId;

            sendToPlayer(opponentId, {
                type: "battleAction",
                battleId,
                fromId: ws.playerId,
                action: data.action,
                nextTurn: b.turn
            });

            return;
        }

        if (data.type === "battleEnd") {
            const battleId = data.battleId;
            const b = battles.get(battleId);

            if (!b) return;

            const opponentId = b.p1 === ws.playerId ? b.p2 : b.p1;

            sendToPlayer(opponentId, {
                type: "battleEnd",
                battleId,
                winnerId: data.winnerId,
                reason: data.reason || "finished"
            });

            const p1entry = players.get(b.p1);
            const p2entry = players.get(b.p2);

            if (p1entry) p1entry.battleId = null;
            if (p2entry) p2entry.battleId = null;

            battles.delete(battleId);
            return;
        }
    });

    ws.on("close", () => {
        const playerId = ws.playerId;
        if (!playerId) return;

        const self = players.get(playerId);

        // If they were mid-battle, tell their opponent so the fight doesn't hang.
        if (self && self.battleId) {
            const b = battles.get(self.battleId);

            if (b) {
                const opponentId = b.p1 === playerId ? b.p2 : b.p1;

                sendToPlayer(opponentId, {
                    type: "battleEnd",
                    battleId: b.battleId,
                    winnerId: opponentId,
                    reason: "opponentDisconnected"
                });

                const opponentEntry = players.get(opponentId);
                if (opponentEntry) opponentEntry.battleId = null;

                battles.delete(b.battleId);
            }
        }

        players.delete(playerId);

        broadcast({ type: "playerLeft", playerId });

        console.log(`${playerId} disconnected`);
    });

    ws.on("error", (error) => {
        console.error("WebSocket error:", error);
    });
});

// Remove connections that disappeared without closing cleanly.
const heartbeat = setInterval(() => {
    for (const ws of wss.clients) {
        if (!ws.isAlive) {
            ws.terminate();
            continue;
        }

        ws.isAlive = false;
        ws.ping();
    }
}, 30000);

wss.on("close", () => {
    clearInterval(heartbeat);
});

console.log("Sagemon overworld + PvP relay server running");